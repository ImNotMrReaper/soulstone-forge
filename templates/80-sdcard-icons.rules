# 80-sdcard-icons.rules — Soul Stone SD Card Icon Classification
# Must run after 60-persistent-storage.rules so ENV{ID_MODEL} etc. are populated.
# Covers: Realtek SD reader (0bda:0177), Generic SD/MMC readers, kernel mmcblk devices.
# External HDDs/SSDs retain their default drive icons.

# Generic SD/MMC model name matching
SUBSYSTEM=="block", ENV{ID_MODEL}=="*SD*", \
  ENV{ID_DRIVE_FLASH_SD}="1", ENV{ID_DRIVE_MEDIA_FLASH_SD}="1", \
  ENV{UDISKS_ICON_NAME}="media-flash-sd"

SUBSYSTEM=="block", ENV{ID_MODEL}=="*MMC*", \
  ENV{ID_DRIVE_FLASH_SD}="1", ENV{ID_DRIVE_MEDIA_FLASH_SD}="1", \
  ENV{UDISKS_ICON_NAME}="media-flash-sd"

SUBSYSTEM=="block", ENV{ID_MODEL}=="*Card*Reader*", \
  ENV{ID_DRIVE_FLASH_SD}="1", ENV{ID_DRIVE_MEDIA_FLASH_SD}="1", \
  ENV{UDISKS_ICON_NAME}="media-flash-sd"

# Realtek exact match (Soul Stone physical reader)
SUBSYSTEM=="block", ENV{ID_VENDOR_ID}=="0bda", ENV{ID_MODEL_ID}=="0177", \
  ENV{ID_DRIVE_FLASH_SD}="1", ENV{ID_DRIVE_MEDIA_FLASH_SD}="1", \
  ENV{UDISKS_ICON_NAME}="media-flash-sd"

# Generic exact match (058f readers)
SUBSYSTEM=="block", ENV{ID_VENDOR_ID}=="058f", \
  ENV{ID_DRIVE_FLASH_SD}="1", ENV{ID_DRIVE_MEDIA_FLASH_SD}="1", \
  ENV{UDISKS_ICON_NAME}="media-flash-sd"

# Kernel native MMC block devices
SUBSYSTEM=="block", KERNEL=="mmcblk*", \
  ENV{ID_DRIVE_FLASH_SD}="1", ENV{ID_DRIVE_MEDIA_FLASH_SD}="1", \
  ENV{UDISKS_ICON_NAME}="media-flash-sd"

# dm-crypt mapped device (soulstone_crypt)
SUBSYSTEM=="block", ENV{DM_NAME}=="soulstone_crypt", \
  ENV{ID_DRIVE_FLASH_SD}="1", ENV{ID_DRIVE_MEDIA_FLASH_SD}="1", \
  ENV{UDISKS_ICON_NAME}="media-flash-sd"

# Soul Stone label match
SUBSYSTEM=="block", ENV{ID_FS_LABEL}=="Soul Stone", \
  ENV{ID_DRIVE_FLASH_SD}="1", ENV{ID_DRIVE_MEDIA_FLASH_SD}="1", \
  ENV{UDISKS_ICON_NAME}="media-flash-sd"
